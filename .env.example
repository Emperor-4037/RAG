# =============================================================================
# Project RAG — Environment Configuration Template
# Copy this file to .env and fill in the values.
# =============================================================================

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=info

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=documents

# --- Redis (Celery Broker + Semantic Cache) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Embedding Model (ONNX, CPU) ---
EMBEDDING_MODEL_NAME=Xenova/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# --- Reranker Model (ONNX, CPU) ---
RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2

# --- LLM Server (llama.cpp) ---
LLM_BASE_URL=http://localhost:8080
LLM_MODEL_PATH=models/model.gguf
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_CONTEXT_WINDOW=4096

# --- Retrieval ---
RETRIEVAL_TOP_K=20
RERANKER_TOP_N=5
SEMANTIC_CACHE_THRESHOLD=0.92

# --- Rate Limiting ---
RATE_LIMIT_QUERY=30/minute
RATE_LIMIT_INGEST=10/minute

# --- Chunking ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- Observability ---
OTEL_SERVICE_NAME=project-rag
OTEL_EXPORTER_TYPE=prometheus
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
